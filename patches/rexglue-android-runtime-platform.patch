+#include <rex/filesystem.h>
+#include <rex/string.h>
+#include <SDL3/SDL_init.h>
+#include <SDL3/SDL_system.h>
+#include <jni.h>
+#include <cerrno>
+#include <climits>
+#include <exception>
+
+namespace rex::filesystem {
+
+int OpenAndroidContentFileDescriptor(const std::string_view uri, const char* mode) {
+  if (uri.empty() || uri.find('\0') != std::string_view::npos || !mode) {
+    errno = EINVAL;
+    return -1;
+  }
+  // SDL's Java bridge is initialized by the Android activity/video context.
+  // Analysis tools without a Java activity may still open ordinary POSIX files.
+  if (!SDL_WasInit(SDL_INIT_VIDEO)) {
+    errno = ENODEV;
+    return -1;
+  }
+  auto* env = static_cast<JNIEnv*>(SDL_GetAndroidJNIEnv());
+  if (!env) { errno = ENODEV; return -1; }
+  auto fail = [&](int error) {
+    if (env->ExceptionCheck()) env->ExceptionClear();
+    errno = error;
+    return -1;
+  };
+  if (env->PushLocalFrame(16) < 0) return fail(ENOMEM);
+  struct LocalFrame {
+    JNIEnv* env;
+    ~LocalFrame() { env->PopLocalFrame(nullptr); }
+  } frame{env};
+  jobject context = static_cast<jobject>(SDL_GetAndroidActivity());
+  if (!context || env->ExceptionCheck()) return fail(ENODEV);
+  jclass context_class = env->GetObjectClass(context);
+  if (!context_class || env->ExceptionCheck()) return fail(EIO);
+  jmethodID get_resolver = env->GetMethodID(context_class, "getContentResolver",
+                                         "()Landroid/content/ContentResolver;");
+  if (!get_resolver || env->ExceptionCheck()) return fail(EIO);
+  jobject resolver = env->CallObjectMethod(context, get_resolver);
+  if (!resolver || env->ExceptionCheck()) return fail(EIO);
+  jclass uri_class = env->FindClass("android/net/Uri");
+  if (!uri_class || env->ExceptionCheck()) return fail(EIO);
+  jmethodID parse = env->GetStaticMethodID(uri_class, "parse", "(Ljava/lang/String;)Landroid/net/Uri;");
+  if (!parse || env->ExceptionCheck()) return fail(EIO);
+  std::u16string text;
+  try { text = rex::string::to_utf16(uri); }
+  catch (const std::exception&) { return fail(EINVAL); }
+  if (text.size() > INT_MAX) return fail(EOVERFLOW);
+  jstring uri_string = env->NewString(reinterpret_cast<const jchar*>(text.data()), jsize(text.size()));
+  if (!uri_string || env->ExceptionCheck()) return fail(ENOMEM);
+  jobject parsed_uri = env->CallStaticObjectMethod(uri_class, parse, uri_string);
+  if (!parsed_uri || env->ExceptionCheck()) return fail(EINVAL);
+  jclass resolver_class = env->GetObjectClass(resolver);
+  if (!resolver_class || env->ExceptionCheck()) return fail(EIO);
+  jmethodID open = env->GetMethodID(resolver_class, "openFileDescriptor",
+      "(Landroid/net/Uri;Ljava/lang/String;)Landroid/os/ParcelFileDescriptor;");
+  if (!open || env->ExceptionCheck()) return fail(EIO);
+  jclass parcel_class = env->FindClass("android/os/ParcelFileDescriptor");
+  if (!parcel_class || env->ExceptionCheck()) return fail(EIO);
+  jmethodID detach = env->GetMethodID(parcel_class, "detachFd", "()I");
+  if (!detach || env->ExceptionCheck()) return fail(EIO);
+  jmethodID close = env->GetMethodID(parcel_class, "close", "()V");
+  if (!close || env->ExceptionCheck()) return fail(EIO);
+  jstring java_mode = env->NewStringUTF(mode);
+  if (!java_mode || env->ExceptionCheck()) return fail(ENOMEM);
+  jobject parcel = env->CallObjectMethod(resolver, open, parsed_uri, java_mode);
+  if (!parcel || env->ExceptionCheck()) return fail(EIO);
+  struct ParcelCloser {
+    JNIEnv* env;
+    jobject parcel;
+    jmethodID close;
+    bool detached = false;
+    ~ParcelCloser() {
+      if (!detached) {
+        env->CallVoidMethod(parcel, close);
+        if (env->ExceptionCheck()) env->ExceptionClear();
+      }
+    }
+  } closer{env, parcel, close};
+  const int descriptor = env->CallIntMethod(parcel, detach);
+  if (env->ExceptionCheck() || descriptor < 0) return fail(EIO);
+  closer.detached = true;
+  // Ownership passes to the native mapped-file wrapper, which closes the fd.
+  return descriptor;
+}
+
+}  // namespace rex::filesystem
