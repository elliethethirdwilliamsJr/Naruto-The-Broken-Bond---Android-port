+++ b/src/core/fiber_android.cpp
@@ -0,0 +1,101 @@
+#include <rex/thread/fiber.h>
+
+#include <algorithm>
+#include <cassert>
+#include <cfenv>
+#include <cstdlib>
+#include <pthread.h>
+#include <signal.h>
+
+// The freestanding context layout is private to this backend. Its sigcontext
+// tag must not collide with Android's kernel signal-context definition.
+namespace native_context {
+#include <libucontext/libucontext.h>
+}
+
+namespace rex::thread {
+
+struct Fiber::AndroidContext {
+  native_context::libucontext_ucontext_t native{};
+  std::fenv_t floating_point{};
+  sigset_t signal_mask{};
+
+  bool CaptureState() {
+    return std::fegetenv(&floating_point) == 0 &&
+           pthread_sigmask(SIG_SETMASK, nullptr, &signal_mask) == 0;
+  }
+  bool RestoreState() {
+    return std::fesetenv(&floating_point) == 0 &&
+           pthread_sigmask(SIG_SETMASK, &signal_mask, nullptr) == 0;
+  }
+};
+
+thread_local Fiber* Fiber::tls_current_ = nullptr;
+
+Fiber* Fiber::ConvertCurrentThread() {
+  if (tls_current_) return tls_current_;
+  auto* fiber = new Fiber();
+  fiber->context_ = new AndroidContext();
+  if (!fiber->context_->CaptureState() ||
+      native_context::libucontext_getcontext(&fiber->context_->native) != 0) {
+    delete fiber->context_;
+    delete fiber;
+    return nullptr;
+  }
+  fiber->is_thread_fiber_ = true;
+  tls_current_ = fiber;
+  return fiber;
+}
+
+Fiber* Fiber::Create(size_t stack_size, void (*entry)(void*), void* arg) {
+  if (!entry) return nullptr;
+  auto* fiber = new Fiber();
+  fiber->context_ = new AndroidContext();
+  fiber->entry_ = entry;
+  fiber->arg_ = arg;
+  fiber->stack_.resize(std::max<size_t>(stack_size ? stack_size : 1024 * 1024, 16384));
+  if (!fiber->context_->CaptureState() ||
+      native_context::libucontext_getcontext(&fiber->context_->native) != 0) {
+    delete fiber->context_;
+    delete fiber;
+    return nullptr;
+  }
+  auto& context = fiber->context_->native;
+  context.uc_stack.ss_sp = fiber->stack_.data();
+  context.uc_stack.ss_size = fiber->stack_.size();
+  context.uc_link = nullptr;
+  native_context::libucontext_makecontext(&context, &Fiber::Trampoline, 0);
+  return fiber;
+}
+
+void Fiber::Trampoline() {
+  Fiber* fiber = tls_current_;
+  fiber->entry_(fiber->arg_);
+}
+
+void Fiber::SwitchTo(Fiber* target) {
+  Fiber* from = tls_current_;
+  if (!from || !target || !target->context_) std::abort();
+  if (from == target) return;
+  if (!from->context_->CaptureState() || !target->context_->RestoreState()) std::abort();
+  // x18 is Android's thread-reserved platform register, not fiber-local state.
+  uintptr_t platform_register;
+  asm volatile("mov %0, x18" : "=r"(platform_register));
+  target->context_->native.uc_mcontext.regs[18] = platform_register;
+  tls_current_ = target;
+  if (native_context::libucontext_swapcontext(&from->context_->native, &target->context_->native) != 0)
+    std::abort();
+}
+
+void Fiber::Destroy() {
+  if (is_thread_fiber_) {
+    assert(this == tls_current_);
+    tls_current_ = nullptr;
+  } else {
+    assert(this != tls_current_);
+  }
+  delete context_;
+  delete this;
+}
+
+}  // namespace rex::thread
