#version 450
layout(local_size_x=1, local_size_y=1) in;
layout(set=0, binding=0) uniform sampler2DArray source_image;
layout(set=0, binding=1, std430) buffer Output { vec4 pixels[]; } output_data;
layout(push_constant) uniform Settings { uint width; uint height; uint level; uint layer; } settings;
void main() {
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x < settings.width && p.y < settings.height)
    {
        uint i = 2 * (p.y * settings.width + p.x);
        output_data.pixels[i] = texelFetch(source_image, ivec3(p, settings.layer), int(settings.level));
        output_data.pixels[i + 1] = textureLod(source_image,
            vec3((vec2(p) + 0.5) / vec2(settings.width, settings.height), settings.layer), float(settings.level));
    }
}
